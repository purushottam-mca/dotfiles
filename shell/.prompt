
## ------------- Prompt on terminal -------------

RESET="\[\017\]"
NORMAL="\[\033[0m\]"
RED="\[\033[31;1m\]"
YELLOW='\[\e[1;33m\]'
GREEN='\[\e[0;32m\]'
WHITE='\[\e[1;37m\]'
SMILEY="${GREEN}:)${NORMAL}"
FROWNY="${RED}:(${NORMAL}"
SELECT="if [ \$? = 0 ]; then echo \"${SMILEY}\"; else echo \"${FROWNY}\"; fi"

PS1="${RESET}${YELLOW}\h:${WHITE} \w \`${SELECT}\` ${YELLOW}${NORMAL}"